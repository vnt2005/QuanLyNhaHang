# Copy this file to .env before running Docker Compose.
# Never commit the real .env file.

# Public API Gateway port used by every frontend and SePay tunnel.
# Keep 8080 for the standard local workflow.
API_PORT=8080

# Docker-served frontend ports. These intentionally differ from Vite dev ports
# so `docker compose up -d --build` and `npm run dev` can run at the same time.
DOCKER_ADMIN_PORT=4173
DOCKER_CUSTOMER_PORT=4174

SQLSERVER_PORT=1433
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Vite development origins.
DEV_ADMIN_ORIGIN=http://localhost:5173
DEV_CUSTOMER_ORIGIN=http://localhost:5174

# Docker/Nginx frontend origins.
DOCKER_ADMIN_ORIGIN=http://localhost:4173
DOCKER_CUSTOMER_ORIGIN=http://localhost:4174

# Both Docker frontends are intentionally built against
# http://localhost:8080. There is no configurable BROWSER_API_BASE_URL in
# local Compose, so stale .env values from older versions cannot point the
# browser back to ports such as 7134.

# SQL Server requires a strong password.
MSSQL_SA_PASSWORD=ChangeThis_LocalOnly_123!

# Use a long random value (at least 32 bytes) outside local development.
JWT_SECRET_KEY=ChangeThis_JwtSecret_LocalOnly_0123456789_ABCDEFGHIJKLMNOPQRSTUVWXYZ
JWT_ISSUER=QuanLyNhaHang
JWT_AUDIENCE=QuanLyNhaHang.Client
JWT_EXPIRES_IN_MINUTES=60

# OpenAI customer assistant.
# Create the real key in your OpenAI project and keep it only in the untracked
# local/deployment .env. Never use a VITE_* variable for this secret.
OPENAI_API_KEY=

# Local email delivery goes to Mailpit. Open http://localhost:8025.
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_ENABLE_SSL=false
EMAIL_USE_AUTHENTICATION=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@quanlynhahang.local

# SePay + VietQR online payment.
# TPBank has an official API Banking connection with SePay. Keep the real bank
# account and webhook secret only in your local/deployment .env file.
SEPAY_BANK_CODE=TPBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_API_KEY=
SEPAY_PAYMENT_PREFIX=DH
# Local safety gate: QR is available only while the tunnel script heartbeat is current.
SEPAY_REQUIRE_WEBHOOK_READINESS=true
SEPAY_WEBHOOK_HEARTBEAT_TIMEOUT_SECONDS=35

# For a real SMTP provider, replace the values above, enable TLS and
# authentication, and keep the real credential only in the untracked .env.
