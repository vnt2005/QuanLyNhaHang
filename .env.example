# Copy this file to .env before running Docker Compose.
# Never commit the real .env file.

API_PORT=8080
SQLSERVER_PORT=1433
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Browser origins allowed to call the API. Do not include trailing slashes.
FRONTEND_ORIGIN=http://localhost:5173
CUSTOMER_FRONTEND_ORIGIN=http://localhost:5174

# SQL Server requires a strong password.
MSSQL_SA_PASSWORD=ChangeThis_LocalOnly_123!

# Use a long random value (at least 32 bytes) outside local development.
JWT_SECRET_KEY=ChangeThis_JwtSecret_LocalOnly_0123456789_ABCDEFGHIJKLMNOPQRSTUVWXYZ
JWT_ISSUER=QuanLyNhaHang
JWT_AUDIENCE=QuanLyNhaHang.Client
JWT_EXPIRES_IN_MINUTES=60

# Local email delivery goes to Mailpit. Open http://localhost:8025.
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_ENABLE_SSL=false
EMAIL_USE_AUTHENTICATION=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@quanlynhahang.local

# SePay + VietQR online payment.
# TPBank has an official API Banking connection with SePay. Keep the real bank
# account and webhook secret only in your local/deployment .env file.
SEPAY_BANK_CODE=TPBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_API_KEY=
SEPAY_PAYMENT_PREFIX=DH

# For a real SMTP provider, replace the values above, enable TLS and
# authentication, and keep the real credential only in the untracked .env.
