# Copy this file to .env before running Docker Compose.
# Never commit the real .env file.

API_PORT=8080
SQLSERVER_PORT=1433

# Browser origin allowed to call the API. Do not include a trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# SQL Server requires a strong password.
MSSQL_SA_PASSWORD=ChangeThis_LocalOnly_123!

# Use a long random value (at least 32 bytes) outside local development.
JWT_SECRET_KEY=ChangeThis_JwtSecret_LocalOnly_0123456789_ABCDEFGHIJKLMNOPQRSTUVWXYZ
JWT_ISSUER=QuanLyNhaHang
JWT_AUDIENCE=QuanLyNhaHang.Client
JWT_EXPIRES_IN_MINUTES=60

# Configure these values before testing 2FA or forgot-password email delivery.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@example.com
